{
  "name": "scalyn/scalyn-mail-relay",
  "description": "WordPress email diagnostics, monitoring, deliverability and remediation platform.",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "autoload": {
    "psr-4": {
      "Scalyn\\MailRelay\\Admin\\": "admin/",
      "Scalyn\\MailRelay\\": "includes/"
    }
  },
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.0"
  },
  "scripts": {
    "lint:php": "find . -path ./vendor -prune -o -path ./.git -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l",
    "lint:wpcs": "phpcs --standard=phpcs.xml.dist",
    "test": "phpunit",
    "check": ["@lint:php", "@lint:wpcs", "@test"]
  }
}
